---
import Layout from '../../layouts/Layout.astro';

const modulos = [
  {
    titulo: 'Módulo 1 · Fundamentos (días 1–10)',
    descripcion: 'Del "Hola mundo" a las estructuras de control. Sin experiencia previa.',
    capitulos: [
      { n: 1, slug: '01-hola-mundo', titulo: 'Hola, Forja', resumen: 'Instalación, primer programa y el comando forja run.' },
      { n: 2, slug: '02-variables', titulo: 'Variables y constantes', resumen: 'variable vs constante, mutabilidad e inferencia de tipos.' },
      { n: 3, slug: '03-tipos', titulo: 'Tipos de datos', resumen: 'Entero, Decimal, Texto, Booleano y conversiones.' },
      { n: 4, slug: '04-operadores', titulo: 'Operadores', resumen: 'Aritméticos, lógicos y de comparación.' },
      { n: 5, slug: '05-condicionales', titulo: 'Condicionales', resumen: 'si / sino / sino si y expresiones condicionales.' },
      { n: 6, slug: '06-bucles', titulo: 'Bucles', resumen: 'mientras, para y control de flujo (romper / continuar).' },
      { n: 7, slug: '07-funciones', titulo: 'Funciones', resumen: 'Parámetros, retorno y ámbito.' },
      { n: 8, slug: '08-texto', titulo: 'Cadenas de texto', resumen: 'Concatenación, interpolación y funciones de texto.' },
      { n: 9, slug: '09-arreglos', titulo: 'Arreglos', resumen: 'Creación, acceso, recorrido y operaciones comunes.' },
      { n: 10, slug: '10-mapas', titulo: 'Mapas', resumen: 'Diccionarios clave-valor y su recorrido.' },
    ],
  },
  {
    titulo: 'Módulo 2 · Intermedio (días 11–20)',
    descripcion: 'Abstracción, modelado de datos y organización del código.',
    capitulos: [
      { n: 11, slug: '11-clases', titulo: 'Clases y objetos', resumen: 'Atributos, constructores, métodos y este.' },
      { n: 12, slug: '12-enums', titulo: 'Enums y tipos algebraicos', resumen: 'Variantes con datos y modelado de estados.' },
      { n: 13, slug: '13-coincidir', titulo: 'Pattern matching', resumen: 'coincidir, patrones y exhaustividad.' },
      { n: 14, slug: '14-genericos', titulo: 'Genéricos', resumen: 'Funciones y estructuras parametrizadas por tipo.' },
      { n: 15, slug: '15-traits', titulo: 'Traits / Interfaces', resumen: 'Contratos, implementaciones y polimorfismo.' },
      { n: 16, slug: '16-resultado', titulo: 'Resultado y Opcion', resumen: 'Manejo de errores con Ok/Error y el operador ?.' },
      { n: 17, slug: '17-modulos', titulo: 'Módulos e importar', resumen: 'Organización en archivos y la biblioteca estándar.' },
      { n: 18, slug: '18-archivos', titulo: 'Archivos y E/S', resumen: 'Leer y escribir archivos, entrada de usuario.' },
      { n: 19, slug: '19-json', titulo: 'JSON y datos', resumen: 'Serialización, parseo y formatos de datos.' },
      { n: 20, slug: '20-pruebas', titulo: 'Pruebas', resumen: 'Atributo &#64;test, aserciones y forja test.' },
    ],
  },
  {
    titulo: 'Módulo 3 · Avanzado (días 21–30)',
    descripcion: 'Concurrencia, GUI, rendimiento y proyectos reales.',
    capitulos: [
      { n: 21, slug: '21-ownership', titulo: 'Ownership y préstamos', resumen: 'Propiedad, referencias y el borrow checker.' },
      { n: 22, slug: '22-concurrencia', titulo: 'Concurrencia', resumen: 'Hilos, canales y select.' },
      { n: 23, slug: '23-iteradores', titulo: 'Iteradores y algoritmos', resumen: 'Recorridos funcionales y algoritmos clásicos.' },
      { n: 24, slug: '24-gui', titulo: 'GUI nativa', resumen: 'Primera app de escritorio con forja-gui-rt.' },
      { n: 25, slug: '25-gui-avanzada', titulo: 'GUI avanzada', resumen: 'Estado, navegación, listas y formularios.' },
      { n: 26, slug: '26-red', titulo: 'Red y HTTP', resumen: 'Cliente/servidor HTTP, sockets y JSON.' },
      { n: 27, slug: '27-sqlite', titulo: 'Persistencia con SQLite', resumen: 'Bases de datos embebidas desde Forja.' },
      { n: 28, slug: '28-paquetes', titulo: 'Paquetes y dependencias', resumen: 'forja.json, forja add y el registry.' },
      { n: 29, slug: '29-rendimiento', titulo: 'Rendimiento y perfilado', resumen: 'JIT, PGO y el profiler integrado.' },
      { n: 30, slug: '30-proyecto-final', titulo: 'Proyecto final', resumen: 'Construí y publicá una app completa.' },
    ],
  },
];

const totalCapitulos = modulos.reduce((acc, m) => acc + m.capitulos.length, 0);
---

<Layout title="Curso: Forja en 30 días — Forja">
  <h1>Forja en 30 días</h1>

  <p>Un curso oficial, progresivo y práctico para aprender <strong>Forja (fa)</strong> desde cero hasta construir y publicar aplicaciones reales. Cada día es un capítulo corto con teoría, ejemplos ejecutables y un ejercicio.</p>

  <div class="info">🔥 <strong>Cómo usar este curso:</strong> leé el capítulo, ejecutá los ejemplos con <code>forja run archivo.fa</code> y resolvé el ejercicio antes de avanzar. Al final de cada módulo hay un mini-proyecto integrador.</div>

  <h2>Requisitos</h2>
  <ul>
    <li>Forja instalado (ver <a href="/docs/instalacion/">Instalación</a>).</li>
    <li>Un editor de texto (recomendado: <a href="/docs/arquitectura/vscode/">extensión VSCode</a>).</li>
    <li>Ganas de escribir código todos los días. 🚀</li>
  </ul>

  <h2>Temario completo ({totalCapitulos} capítulos)</h2>

  {modulos.map((modulo) => (
    <section class="modulo">
      <h3>{modulo.titulo}</h3>
      <p class="modulo-desc">{modulo.descripcion}</p>
      <div class="capitulos">
        {modulo.capitulos.map((cap) => (
          <a class="capitulo" href={`/docs/curso/${cap.slug}/`}>
            <span class="cap-num">{String(cap.n).padStart(2, '0')}</span>
            <span class="cap-body">
              <span class="cap-titulo">{cap.titulo}</span>
              <span class="cap-resumen">{cap.resumen}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <h2>Solucionario</h2>
  <p>Todas las soluciones de los ejercicios están disponibles en el <a href="/docs/curso/solucionario/">solucionario</a>, con el código completo y la salida esperada de cada capítulo.</p>

  <div class="info">💡 <strong>Consejo:</strong> si te trabás, ejecutá <code>forja learn</code> en la terminal para practicar los conceptos base de forma interactiva.</div>

  <style>
    .modulo { margin: 2rem 0; }
    .modulo-desc { color: var(--text-dim); margin-bottom: 1rem; }
    .capitulos { display: grid; gap: 0.5rem; }
    .capitulo {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 1rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      text-decoration: none;
      color: var(--text);
      transition: border-color 0.15s, background 0.15s;
    }
    .capitulo:hover { border-color: var(--fuego); background: var(--bg-hover); }
    .cap-num {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--fuego);
      min-width: 2rem;
    }
    .cap-body { display: flex; flex-direction: column; }
    .cap-titulo { font-weight: 600; }
    .cap-resumen { font-size: 0.85rem; color: var(--text-dim); }
  </style>
</Layout>
