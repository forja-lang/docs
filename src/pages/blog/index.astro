---
import Layout from '../../layouts/Layout.astro';

const entradas = [
  {
    slug: 'lanzamiento',
    fecha: 'Octubre 2026',
    titulo: 'Forja: un lenguaje de programación que habla tu idioma',
    resumen:
      'Por qué construimos un lenguaje educativo en español con contratos y tipado, que compila a nativo, GUI, WASM y Android.',
    etiquetas: ['Lanzamiento', 'Motivación'],
  },
];
---

<Layout
  title="Blog — Forja"
  description="Notas, anuncios y artículos sobre el lenguaje de programación Forja."
>
  <h1>Blog</h1>
  <p>Notas y anuncios del proyecto Forja.</p>

  <div class="post-list">
    {entradas.map((e) => (
      <a class="post-item" href={`/docs/blog/${e.slug}/`}>
        <div class="post-item-fecha">{e.fecha}</div>
        <div class="post-item-titulo">{e.titulo}</div>
        <div class="post-item-resumen">{e.resumen}</div>
        <div class="post-item-tags">
          {e.etiquetas.map((t) => (
            <span class="post-item-tag">{t}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .post-list { display: grid; gap: 12px; margin-top: 24px; }
  .post-item {
    display: block;
    padding: 18px 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .post-item:hover {
    border-color: var(--fuego);
    background: var(--bg-hover);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .post-item-fecha {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .post-item-titulo {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
  }
  .post-item:hover .post-item-titulo { color: var(--fuego-light); }
  .post-item-resumen { font-size: 0.88rem; color: var(--text-dim); margin-bottom: 10px; }
  .post-item-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .post-item-tag {
    font-size: 0.7rem;
    color: var(--fuego-light);
    background: var(--fuego-bg);
    border-radius: 20px;
    padding: 2px 10px;
  }
</style>
