  <h4>Asignaciones como expresión</h4>
  <table>
    <thead>
      <tr><th>Variante</th><th>Descripción</th><th>Ejemplo Forja</th></tr>
    </thead>
    <tbody>
      <tr><td><code>Asignacion { variable, valor }</code></td><td>Asignación como expresión (retorna el valor)</td><td><code>x = 5</code></td></tr>
