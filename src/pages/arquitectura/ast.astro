    </tbody>
  </table>

  <h4>Concurrencia y control</h4>
  <table>
    <thead>
      <tr><th>Variante</th><th>Descripción</th><th>Ejemplo Forja</th></tr>
    </thead>
    <tbody>
      <tr><td><code>Hilo { cuerpo }</code></td><td>Creación de hilo ligero</td><td><code>hilo { ... }</code></td></tr>
      <tr><td><code>CanalNuevo</code></td><td>Creación de canal de comunicación</td><td><code>canal()</code></td></tr>
      <tr><td><code>Seleccionar { brazos }</code></td><td>Selección entre múltiples canales (select)</td><td><code>seleccionar { ... }</code></td></tr>
      <tr><td><code>Coincidir { expr, brazos }</code></td><td>Pattern matching sobre una expresión</td><td><code>coincidir expr { ... }</code></td></tr>
    </tbody>
  </table>

  <hr />

  <h2>Declaraciones</h2>

  <h3><code>Declaracion</code> — Todas las declaraciones del lenguaje (20 variantes)</h3>

  <h4>Variables y asignaciones</h4>
  <table>
    <thead>
      <tr><th>Variante</th><th>Descripción</th><th>Ejemplo Forja</th></tr>
    </thead>
    <tbody>
      <tr><td><code>Variable { mutable, nombre, tipo, valor, linea, columna }</code></td><td>Declaración de variable (inmutable o mutable)</td><td><code>variable x = 5</code> / <code>variable mutable y = 10</code></td></tr>
      <tr><td><code>Asignacion { nombre, valor, linea, columna }</code></td><td>Asignación a variable existente</td><td><code>x = 10</code></td></tr>
      <tr><td><code>AsignacionMiembro { objeto, miembro, valor, linea, columna }</code></td><td>Asignación a campo de objeto</td><td><code>este.nombre = "Ana"</code></td></tr>
      <tr><td><code>AsignacionIndex { nombre, indice, valor, linea, columna }</code></td><td>Asignación por índice</td><td><code>arr[0] = 10</code></td></tr>
      <tr><td><code>AsignacionMultiple { variables, mutable, valor }</code></td><td>Asignación múltiple (ej: canal tx, rx)</td><td><code>variable tx, rx = canal()</code></td></tr>
    </tbody>
  </table>

