<span class="fn">tarjeta_elevada</span>(<span class="fn">columna</span>(...))
<span class="fn">tarjeta_perfilada</span>(<span class="fn">columna</span>(...))
<span class="fn">tarjeta_seleccionable</span>(<span class="fn">columna</span>(...), &amp;<span class="fn">on_click</span>, seleccionado)

<span class="co">// List Items</span>
<span class="fn">elemento_lista</span>(<span class="st">"Título"</span>, <span class="st">"Subtítulo"</span>, icono, &amp;<span class="fn">fn</span>)
<span class="fn">elemento_lista_doble</span>(<span class="st">"Título"</span>, <span class="st">"Subtítulo"</span>, icono, &amp;<span class="fn">fn</span>)
<span class="fn">lista</span>([item1, item2])
<span class="fn">lista_con_dividores</span>([item1, item2])
<span class="fn">lista_control</span>([item1, item2], <span class="st">"checkbox"</span>, [<span class="st">"var1"</span>, <span class="st">"var2"</span>])
<span class="fn">lista_seleccion</span>([item1, item2], selecciones, &amp;<span class="fn">fn</span>, <span class="cn">verdadero</span>)

