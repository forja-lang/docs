  <h2>Navegación</h2>

  <h3>Navigator (gestor de pantallas)</h3>
  <pre><code><span class="kw">variable</span> pantalla_actual = <span class="st">"inicio"</span>

<span class="kw">funcion</span> <span class="fn">cambiar</span>(id) &#123;
    pantalla_actual = id
&#125;

<span class="kw">funcion</span> <span class="fn">main</span>() &#123;
    <span class="fn">navegador</span>(
        <span class="fn">navegador_pantallas</span>(
            <span class="fn">pantalla</span>(<span class="st">"Inicio"</span>, <span class="fn">columna</span>(<span class="fn">etiqueta</span>(<span class="st">"Home"</span>))),
            <span class="fn">pantalla</span>(<span class="st">"Perfil"</span>, <span class="fn">columna</span>(<span class="fn">etiqueta</span>(<span class="st">"Profile"</span>)))
        ),
        <span class="st">"pantalla_actual"</span>,
        <span class="st">"barra"</span>,
        &amp;<span class="fn">cambiar</span>,
        <span class="st">"fade"</span>      <span class="co">// animación opcional</span>
    )
&#125;</code></pre>

  <p><strong>Tipos de navegación:</strong></p>
  <table>
