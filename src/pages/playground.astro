---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Playground — Forja">
  <h1>Playground interactivo</h1>

  <p>Escribí código Forja en el editor, ejecutalo en la VM y mirá el resultado en vivo.</p>

  <div class="playground-layout">
    <div class="editor-panel">
      <div class="panel-header">
        <span>📝 Código Forja (.fa)</span>
        <div class="panel-actions">
          <label class="live-toggle" title="Ejecutar automáticamente al escribir">
            <span class="live-label">Live</span>
            <input type="checkbox" id="liveSwitch" checked>
            <span class="toggle-track"><span class="toggle-thumb"></span></span>
          </label>
          <button id="btnRun" class="btn-run">▶ Ejecutar</button>
          <button id="btnGui" class="btn-gui" title="Renderizar la interfaz en el canvas">🎨 GUI</button>
          <button id="btnClear" class="btn-clear">🗑 Limpiar</button>
        </div>
      </div>
      <textarea id="codigo" class="editor" spellcheck="false" placeholder='Escribí tu código Forja acá'>escribir("¡Hola, mundo desde Forja!")</textarea>
    </div>
    <div class="output-panel">
      <div class="panel-header">
        <span>📋 Output</span>
        <span id="status" class="status-idle">✓ listo</span>
      </div>
      <div id="output" class="output">
        <span class="placeholder">Presioná ▶ Ejecutar para correr el código</span>
      </div>
    </div>
  </div>

  <!-- GUI Canvas section -->
  <div class="gui-section" id="guiSection" style="display:none;">
    <h2>GUI Canvas</h2>
    <div class="gui-canvas-container">
      <canvas id="forja-canvas" width="600" height="400"></canvas>
    </div>
  </div>

  <h2>Ejemplos rápidos</h2>

  <div class="example-buttons">
    <button class="example-btn" data-code='escribir("¡Hola, mundo desde Forja!")'>Hola Mundo</button>
    <button class="example-btn" data-code='variable nombre = "Gaucho"\nvariable edad = 30\nescribir("Nombre: " + nombre)\nescribir("Edad: " + edad)'>Variables</button>
    <button class="example-btn" data-code='funcion suma(a, b) &#123;\n    retornar a + b\n&#125;\nescribir("2 + 3 = " + suma(2, 3))'>Función</button>
    <button class="example-btn" data-code='clase P &#123;\n    nombre\n    constructor(n) &#123;\n        este.nombre = n\n    &#125;\n    funcion sal() &#123;\n        escribir(este.nombre)\n    &#125;\n&#125;\nvariable p = nuevo P("Ana")\np.sal()'>Clase</button>
    <button class="example-btn" data-code='variable i = 0\nmientras (i < 5) &#123;\n    escribir("i = " + i)\n    i = i + 1\n&#125;'>Bucle</button>
    <button class="example-btn" data-code='funcion fib(n) &#123;\n    si (n <= 1) &#123;\n        retornar n\n    &#125;\n    retornar fib(n-1) + fib(n-2)\n&#125;\nescribir("fib(10) = " + fib(10))'>Fibonacci</button>
    <button class="example-btn" data-code='variable nombre = "Carlos"\nvariable edad = 30\nescribir("Hola $&#123;nombre&#125;, tenés $&#123;edad&#125; años")'>Interpolación</button>
    <button class="example-btn" data-code='funcion dividir(a: Entero, b: Entero) -> Resultado<Entero, Texto> &#123;\n    si (b == 0) &#123; retornar Error("No se puede dividir por cero") &#125;\n    retornar Ok(a / b)\n&#125;\nfuncion ejecutar() -> Resultado<Entero, Texto> &#123;\n    variable r = dividir(10, 2)?\n    escribir(r)\n    retornar Ok(r)\n&#125;\nejecutar()'>Resultado</button>
    <button class="example-btn" data-code='rasgo Saludador &#123;\n    funcion saludar()\n&#125;\nclase Persona &#123;\n    nombre\n    constructor(n) &#123; este.nombre = n &#125;\n&#125;\nimplementa Saludador para Persona &#123;\n    funcion saludar() &#123;\n        escribir("Hola, soy " + este.nombre)\n    &#125;\n&#125;\nvariable p = nuevo Persona("Ana")\np.saludar()'>Rasgos</button>
    <button class="example-btn" data-code='funcion identidad<T>(valor: T) -> T &#123;\n    retornar valor\n&#125;\nescribir(identidad(42))\nescribir(identidad("hola"))'>Genéricos</button>
    <button class="example-btn" data-code='variable tx, rx = canal()\nvariable h = hilo &#123;\n    tx.enviar(42)\n&#125;\nvariable dato = rx.recibir()\nescribir(dato)\nh.unir()'>Concurrencia</button>
    <button class="example-btn" data-code='variable numeros = [3, 1, 4, 1, 5, 9, 2, 6]\nvariable suma = 0\npara (variable i = 0; i < longitud(numeros); i = i + 1) &#123;\n    suma = suma + numeros[i]\n&#125;\nescribir("Suma: " + suma)'>Arreglos</button>
    <button class="example-btn" data-code='variable edades = &#123;"Ana": 25, "Luis": 30, "Eva": 28&#125;\nvariable nombres = ["Ana", "Luis", "Eva"]\npara (variable i = 0; i < longitud(nombres); i = i + 1) &#123;\n    variable nombre = nombres[i]\n    escribir(nombre + " tiene " + edades[nombre] + " años")\n&#125;'>Mapas</button>
    <button class="example-btn" data-code='tipo Forma = Circulo(Decimal) | Rectangulo(Decimal, Decimal)\nfuncion area(f: Forma) -> Decimal &#123;\n    coincidir (f) &#123;\n        caso Circulo(r) -> &#123; retornar 3.14159 * r * r &#125;\n        caso Rectangulo(a, b) -> &#123; retornar a * b &#125;\n    &#125;\n&#125;\nescribir(area(Circulo(2.0)))\nescribir(area(Rectangulo(3.0, 4.0)))'>Enums y match</button>
    <button class="example-btn" data-code='variable arr = [5, 2, 9, 1, 7, 3]\nvariable n = longitud(arr)\npara (variable i = 0; i < n; i = i + 1) &#123;\n    para (variable j = 0; j < n - i - 1; j = j + 1) &#123;\n        si (arr[j] > arr[j + 1]) &#123;\n            variable tmp = arr[j]\n            arr[j] = arr[j + 1]\n            arr[j + 1] = tmp\n        &#125;\n    &#125;\n&#125;\nescribir(arr)'>Ordenamiento</button>
    <button class="example-btn" data-code='funcion es_primo(n) &#123;\n    si (n < 2) &#123; retornar falso &#125;\n    variable i = 2\n    mientras (i * i <= n) &#123;\n        si (n % i == 0) &#123; retornar falso &#125;\n        i = i + 1\n    &#125;\n    retornar verdadero\n&#125;\npara (variable i = 1; i <= 20; i = i + 1) &#123;\n    si (es_primo(i)) &#123; escribir(i + " es primo") &#125;\n&#125;'>Primos</button>
    <button class="example-btn" data-code='importar gui\nvariable contador = 0\nvariable resultado = "Valor: " + contador\nfuncion incrementar() -> Texto &#123; retornar "" &#125;\nfuncion main() &#123;\n    columna(\n        titulo("Contador"),\n        escribir(resultado),\n        boton("Incrementar", &incrementar)\n    )\n&#125;'>GUI: contador</button>
    <button class="example-btn" data-code='importar std/json\nfuncion ejecutar() -> Resultado<Texto, ErrorJSON> &#123;\n    variable datos = &#123;"nombre": "Ana", "edad": 25, "activo": verdadero&#125;\n    variable texto = serializar(datos)?\n    escribir(texto)\n    variable recuperado = parsear(texto)?\n    escribir(recuperado["nombre"])\n    retornar Ok(texto)\n&#125;\nejecutar()'>JSON</button>
  </div>
</Layout>

<style is:global>
  .playground-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
    min-height: 450px;
  }
  .editor-panel, .output-panel {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-card);
  }
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    background: linear-gradient(135deg, var(--bg-hover), var(--bg-card));
    border-bottom: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    gap: 8px;
    flex-wrap: wrap;
  }
  .panel-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .live-toggle {
    display: flex; align-items: center; gap: 6px; cursor: pointer; user-select: none;
  }
  .live-label {
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.5px; color: var(--text-muted); transition: color 0.2s;
  }
  .live-toggle input { display: none; }
  .toggle-track {
    width: 36px; height: 20px; background: var(--bg-elevated);
    border: 1px solid var(--border); border-radius: 10px;
    position: relative; transition: all 0.25s ease;
  }
  .toggle-thumb {
    position: absolute; top: 2px; left: 2px; width: 14px; height: 14px;
    background: var(--text-muted); border-radius: 50%; transition: all 0.25s ease;
  }
  .live-toggle input:checked + .toggle-track {
    background: rgba(16, 185, 129, 0.2); border-color: var(--verde);
  }
  .live-toggle input:checked + .toggle-track .toggle-thumb {
    left: 18px; background: var(--verde); box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
  }
  .live-toggle:has(input:checked) .live-label { color: var(--verde); }
  .btn-run {
    background: var(--verde); color: #000; border: none;
    padding: 4px 14px; border-radius: 6px; cursor: pointer;
    font-size: 0.78rem; font-weight: 600; font-family: var(--font);
    transition: all 0.15s;
  }
  .btn-run:hover { filter: brightness(1.2); transform: translateY(-1px); }
  .btn-gui {
    background: linear-gradient(135deg, #6750A4, #7C6FBE); color: #fff; border: none;
    padding: 4px 14px; border-radius: 6px; cursor: pointer;
    font-size: 0.78rem; font-weight: 600; font-family: var(--font);
    transition: all 0.15s;
  }
  .btn-gui--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    filter: grayscale(0.6);
    pointer-events: auto;
  }
  .btn-gui--disabled:hover {
    opacity: 0.7;
    filter: grayscale(0.4);
    transform: none;
  }
  .btn-clear {
    background: var(--bg-elevated); color: var(--text-dim);
    border: 1px solid var(--border); padding: 4px 10px; border-radius: 6px;
    cursor: pointer; font-size: 0.78rem; font-family: var(--font);
    transition: all 0.15s;
  }
  .btn-clear:hover { border-color: var(--fuego); color: var(--fuego-light); }
  .editor {
    flex: 1; min-height: 350px; padding: 16px;
    font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.6;
    color: #e2e8f0; background: var(--bg-card); border: none; outline: none;
    resize: vertical; tab-size: 4;
  }
  .editor::placeholder { color: var(--text-muted); }
  .output {
    flex: 1; min-height: 350px; padding: 16px;
    font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.6;
    color: var(--text-dim); white-space: pre-wrap; overflow-y: auto;
    background: var(--bg-card);
  }
  .output .placeholder { color: var(--text-muted); font-style: italic; }
  .output .stdout { color: var(--verde); }
  .output .stderr { color: var(--rojo); }
  .status-idle { color: var(--verde); font-size: 0.75rem; }
  .status-running { color: var(--fuego-light); font-size: 0.75rem; }
  .status-error { color: var(--rojo); font-size: 0.75rem; }
  .status-timing { color: var(--acero-light); font-size: 0.7rem; }
  .example-buttons { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .example-btn {
    padding: 6px 14px; background: var(--bg-card);
    border: 1px solid var(--border); border-radius: 6px;
    color: var(--text-dim); font-size: 0.82rem; font-family: var(--font);
    cursor: pointer; transition: all 0.15s;
  }
  .example-btn:hover {
    border-color: var(--fuego); color: var(--fuego-light); background: var(--fuego-bg);
  }
  .gui-section {
    margin-bottom: 24px;
  }
  .gui-section h2 {
    font-size: 1.1rem;
    margin-bottom: 8px;
    color: var(--text);
  }
  .gui-canvas-container {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-card);
    display: flex;
    justify-content: center;
    padding: 8px;
  }
  #forja-canvas {
    display: block;
    max-width: 100%;
    border-radius: 6px;
    background: #fef7ff;
  }
  @media (max-width: 768px) { .playground-layout { grid-template-columns: 1fr; } }

</style>

<script>
  let wasmLoaded: boolean = false;
  let forjaWasm: any = null;
  let guiWasmLoaded: boolean = false;
  let forjaWasmGui: any = null;
  let guiError: string | null = null;

  // Los builtins de GUI (columna, fila, titulo, boton…) sólo existen en el
  // runtime GUI: un programa así no produce salida en la VM.
  const RE_GUI = /\b(columna|fila|pila|titulo|boton)\s*\(/;

  async function cargarWASM() {
    try {
      // @ts-ignore
      forjaWasm = await import('../wasm/forja_wasm.js');
      await forjaWasm.default(); // Inicializar el WASM (descargar y compilar .wasm)
      // El primer `forja_ejecutar` cuesta ~40 ms (arranque de la VM): se calienta
      // acá para que el tiempo que se muestra sea el de régimen normal.
      try {
        forjaWasm.forja_ejecutar('escribir("")');
      } catch {
        // si el calentamiento falla, el error real aparece al ejecutar
      }
      wasmLoaded = true;
      console.log('✅ Forja WASM cargado exitosamente');
    } catch (e: any) {
      console.warn('⚠ Forja WASM no disponible:', e.message);
      wasmLoaded = false;
    }
  }

  async function cargarWASMGUI() {
    try {
      // @ts-ignore
      forjaWasmGui = await import('../wasm/forja_wasm_gui.js');
      await forjaWasmGui.default();
      guiWasmLoaded = true;
      console.log('✅ Forja WASM GUI cargado exitosamente');
    } catch (e: any) {
      console.warn('⚠ Forja WASM GUI no disponible:', e.message);
      guiError = e.message;
      guiWasmLoaded = false;
    }
  }

  function initPlayground() {
    const codigo = document.getElementById('codigo') as HTMLTextAreaElement;
    const output = document.getElementById('output') as HTMLDivElement;
    const status = document.getElementById('status') as HTMLSpanElement;
    const btnRun = document.getElementById('btnRun') as HTMLButtonElement;
    const btnGui = document.getElementById('btnGui') as HTMLButtonElement;
    const btnClear = document.getElementById('btnClear') as HTMLButtonElement;
    const liveSwitch = document.getElementById('liveSwitch') as HTMLInputElement;
    const guiSection = document.getElementById('guiSection') as HTMLDivElement;
    let liveTimeout: any = null;

    if (!codigo || !output || !status || !btnRun || !btnGui || !btnClear || !liveSwitch) {
      console.warn('⚠ Faltan elementos esenciales en el DOM del playground');
      return;
    }
    status.title = 'Tiempo del último programa, sin contar la carga del WASM';

    function setStatus(text: string, className: string) {
      status.textContent = text;
      status.className = className;
    }

    function mostrarOutput(texto: string) {
      output.innerHTML = '';
      if (!texto) {
        output.innerHTML = '<span class="placeholder">(sin output)</span>';
        return;
      }
      const lineas = texto.split('\n');
      for (const linea of lineas) {
        const div = document.createElement('div');
        div.className = 'stdout';
        div.textContent = linea;
        output.appendChild(div);
      }
    }

    function ejecutar() {
      const source = codigo.value.trim();
      if (!source) {
        output.innerHTML = '<span class="stderr">⚠ No hay código para ejecutar</span>';
        return;
      }
      // Los builtins de GUI sólo existen en el runtime GUI: un programa así no
      // escribe nada en la VM, así que va directo al canvas.
      if (RE_GUI.test(source)) {
        ejecutarGUI();
        return;
      }
      setStatus('⏳ ejecutando...', 'status-running');
      output.innerHTML = '<span class="placeholder">Ejecutando...</span>';

      setTimeout(async () => {
        try {
          if (wasmLoaded && forjaWasm && typeof forjaWasm.forja_ejecutar === 'function') {
            // El cronómetro arranca acá: el setTimeout del repintado no es tiempo
            // de ejecución (antes sumaba 50 ms fijos y no cerraba con la home).
            const inicio = performance.now();
            const resultado = forjaWasm.forja_ejecutar(source);
            const tiempoMs = (performance.now() - inicio).toFixed(2);
            mostrarOutput(String(resultado ?? ''));
            setStatus('⚡ ' + tiempoMs + ' ms', 'status-timing');
          } else {
            // Fallback: mostrar mensaje
            output.innerHTML = '';
            const div = document.createElement('div');
            div.className = 'stderr';
            div.textContent = '⚠ WASM no disponible. Ejecutá scripts\\build-wasm.ps1';
            output.appendChild(div);
            setStatus('⚠ sin WASM', 'status-error');
          }
        } catch (err: any) {
          output.innerHTML = '<span class="stderr">⛔ ' + err.message + '</span>';
          setStatus('❌ error', 'status-error');
        }
      }, 50);
    }

    function ejecutarGUI() {
      const source = codigo.value.trim();
      if (!source) {
        output.innerHTML = '<span class="stderr">⚠ No hay código para ejecutar</span>';
        return;
      }
      if (!RE_GUI.test(source)) {
        // Sin builtins de GUI no hay nada que dibujar: mejor decirlo que mostrar
        // un canvas en blanco con un "✓" mentiroso.
        setStatus('⚠ sin GUI', 'status-error');
        output.innerHTML = '<span class="stderr">⚠ Este código no arma una interfaz. Usá los builtins de GUI (columna, fila, titulo, boton…) dentro de main().</span>';
        return;
      }

      setStatus('🎨 renderizando GUI...', 'status-running');

      setTimeout(async () => {
        try {
          if (!(guiWasmLoaded && forjaWasmGui && typeof forjaWasmGui.ejecutar_gui === 'function')) {
            setStatus('⚠ sin GUI WASM', 'status-error');
            output.innerHTML =
              '<span class="stderr">⚠ El runtime GUI no cargó' +
              (guiError ? ': ' + guiError : '') +
              '</span>';
            return;
          }
          const resultado = forjaWasmGui.ejecutar_gui('forja-canvas', source);
          if (resultado === 'ok') {
            if (guiSection) guiSection.style.display = 'block';
            setStatus('✓ GUI renderizada', 'status-timing');
          } else {
            setStatus('⚠ ' + resultado, 'status-error');
            output.innerHTML = '<span class="stderr">⚠ ' + resultado + '</span>';
          }
        } catch (err: any) {
          // Un fallo del runtime GUI no debe romper el resto del playground: se
          // marca como no disponible y se sigue usando la VM normal.
          guiWasmLoaded = false;
          guiError = err.message;
          setStatus('❌ error GUI', 'status-error');
          output.innerHTML = '<span class="stderr">⛔ ' + err.message + '</span>';
        }
      }, 50);
    }

    function limpiar() {
      codigo.value = '';
      output.innerHTML = '<span class="placeholder">Editor limpiado</span>';
      setStatus('✓ listo', 'status-idle');
    }

    function cargarEjemplo(code: string) {
      codigo.value = code.replace(/\\n/g, '\n');
      output.innerHTML = '<span class="placeholder">Código cargado</span>';
      if (liveSwitch.checked) ejecutar();
      else setStatus('✓ listo', 'status-idle');
    }

    function onCodigoChange() {
      if (!liveSwitch.checked) return;
      if (liveTimeout) clearTimeout(liveTimeout);
      liveTimeout = setTimeout(() => {
        if (codigo.value.trim()) ejecutar();
      }, 400);
    }

    btnRun.addEventListener('click', ejecutar);
    btnGui.addEventListener('click', ejecutarGUI);
    btnClear.addEventListener('click', limpiar);
    codigo.addEventListener('input', onCodigoChange);

    liveSwitch.addEventListener('change', () => {
      if (liveSwitch.checked) {
        setStatus('⚡ en vivo', 'status-idle');
        if (codigo.value.trim()) ejecutar();
      } else {
        setStatus('✓ manual', 'status-idle');
      }
    });

    codigo.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); ejecutar(); }
    });

    document.querySelectorAll('.example-btn').forEach(element => {
      const btn = element as HTMLButtonElement;
      btn.addEventListener('click', () => {
        if (btn.dataset.code) cargarEjemplo(btn.dataset.code);
      });
    });

    // Cargar WASM y ejecutar auto si hay código y live está activo
    Promise.all([
      cargarWASM(),
      cargarWASMGUI(),
    ]).then(() => {
      if (codigo.value.trim() && liveSwitch.checked) ejecutar();
    });
  }

  document.addEventListener('DOMContentLoaded', initPlayground);
  window.addEventListener('page-loaded', () => {
    if (document.getElementById('codigo')) initPlayground();
  });
</script>