---
import Sidebar from "./Sidebar.astro";
import { headerNav, repoUrl, siteTagline, siteTitle } from "../data/site";

const current = Astro.url.pathname.replace(/\/+$/, "") || "/docs";
const isCurrent = (href: string) => current.startsWith(href.replace(/\/+$/, ""));
---

<header class="site-header">
  <div class="header-inner container-wide">
    <a class="brand" href="/docs/" aria-label={`${siteTitle} — inicio`}>
      <img class="brand-mark" src="/docs/logo.png" alt="" width="34" height="34" />
      <span class="brand-text">
        <span class="brand-name">{siteTitle}</span>
        <span class="brand-tag">{siteTagline}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Principal">
      {headerNav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
          {item.title}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="btn btn-primary btn-sm" href="/docs/instalacion/">Instalar</a>

      <a class="icon-btn" href={repoUrl} target="_blank" rel="noreferrer" aria-label="Repositorio en GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.48v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.1-1.5-1.1-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.88 1.55 2.3 1.1 2.86.84.09-.66.34-1.1.62-1.36-2.22-.26-4.55-1.14-4.55-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9v2.81c0 .27.18.58.69.48A10.14 10.14 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
        </svg>
      </a>

      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Cambiar tema">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19" />
        </svg>
      </button>

      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu container-wide" id="mobile-menu">
    <Sidebar drawer />
  </div>
</header>
