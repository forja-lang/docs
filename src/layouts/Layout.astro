---
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import SpriteIconos from "../components/SpriteIconos.astro";
import { fuentePara } from "../data/codigo";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Documentación del lenguaje de programación Forja (fa)" } = Astro.props;
const fuente = fuentePara(Astro.url.pathname);
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title.includes("Forja") ? title : `${title} | Forja`}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/docs/favicon.ico" />
    <meta name="theme-color" content="#0a0908" data-theme-color />
    <ClientRouter />

    <script is:inline>
      // El tema se aplica antes del primer paint para no parpadear.
      (() => {
        const query = new URLSearchParams(location.search).get("theme");
        const stored = localStorage.getItem("forja-theme");
        const theme = query === "light" || query === "dark" ? query : stored === "light" || stored === "dark" ? stored : "dark";
        if (query === "light" || query === "dark") localStorage.setItem("forja-theme", theme);
        document.documentElement.dataset.theme = theme;
        document
          .querySelector("[data-theme-color]")
          ?.setAttribute("content", theme === "light" ? "#f7f4ee" : "#0a0908");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Saltar al contenido</a>
    <div id="progress" aria-hidden="true"></div>
    <SpriteIconos />

    <Header />

    <div class="docs-shell container-wide">
      <aside class="docs-sidebar" aria-label="Documentación">
        <Sidebar />
      </aside>

      <main class="docs-content prose" id="content" data-content>
        <slot />

        {fuente && (
          <section class="ver-codigo" data-ver-codigo data-repo={fuente.repo} data-ruta={fuente.path}>
            <div class="ver-codigo-head">
              <span class="ver-codigo-titulo">
                <svg class="ico" aria-hidden="true"><use href="#i-code"/></svg>
                {fuente.repo.replace("forja-lang/", "")}/{fuente.path}
              </span>
              <button type="button" class="btn btn-sm ver-codigo-btn" data-ver-codigo-btn>
                <svg class="ico" aria-hidden="true"><use href="#i-code"/></svg> Ver código
              </button>
            </div>
            <div class="ver-codigo-cuerpo" data-ver-codigo-cuerpo hidden></div>
          </section>
        )}
      </main>

      <aside class="docs-toc" aria-label="En esta página">
        <div class="docs-label">En esta página</div>
        <nav class="toc-nav" data-toc></nav>
      </aside>
    </div>

    <Footer />

    <script>
      import { navLinks } from "../data/nav";
      import { ejecutarForja } from "../wasm/run.js";
      import { resaltarForja, resaltarRust } from "../wasm/highlight.js";

      /* ── Tema ──────────────────────────────────────────────── */
      const THEME_KEY = "forja-theme";

      function aplicarTema(theme: "dark" | "light") {
        document.documentElement.dataset.theme = theme;
        document
          .querySelector("[data-theme-color]")
          ?.setAttribute("content", theme === "light" ? "#f7f4ee" : "#0a0908");
      }

      function setTheme(theme: "dark" | "light") {
        aplicarTema(theme);
        localStorage.setItem(THEME_KEY, theme);
      }

      /* ── Listener delegados: el router reemplaza el <body> ── */
      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        if (target.closest("[data-theme-toggle]")) {
          setTheme(document.documentElement.dataset.theme === "light" ? "dark" : "light");
          return;
        }

        if (target.closest("[data-menu-toggle]")) {
          const menu = document.querySelector<HTMLElement>("#mobile-menu");
          const open = menu?.classList.toggle("is-open") ?? false;
          document.documentElement.style.overflow = open ? "hidden" : "";
          document.querySelector("[data-menu-toggle]")?.setAttribute("aria-expanded", String(open));
          return;
        }

        const copy = target.closest<HTMLButtonElement>("[data-copy]");
        if (copy) {
          const code = copy.closest(".code-block-wrapper")?.querySelector("pre")?.textContent ?? "";
          navigator.clipboard.writeText(code);
          copy.textContent = "Copiado";
          copy.classList.add("is-copied");
          setTimeout(() => {
            copy.textContent = "Copiar";
            copy.classList.remove("is-copied");
          }, 1600);
        }
      });

      document.addEventListener("input", (event) => {
        const input = event.target as HTMLInputElement | null;
        if (!input?.matches("[data-nav-search]")) return;
        const query = input.value.trim().toLowerCase();
        document.querySelectorAll<HTMLElement>("[data-nav] .docs-group").forEach((group) => {
          let visible = 0;
          group.querySelectorAll("a").forEach((link) => {
            const match = (link.textContent ?? "").toLowerCase().includes(query);
            link.hidden = !match;
            if (match) visible++;
          });
          group.hidden = query.length > 0 && visible === 0;
        });
      });

      /* ── Estado activo del sidebar ─────────────────────────── */
      const normalize = (path: string) => path.replace(/\/+$/, "") || "/docs";

      function markActive() {
        const current = normalize(location.pathname);
        document.querySelectorAll<HTMLElement>("[data-nav]").forEach((nav) => {
          let best: HTMLAnchorElement | null = null;
          let bestLength = -1;
          nav.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
            const href = normalize(link.getAttribute("href") ?? "");
            if (!href.startsWith("/docs")) return;
            if ((current === href || current.startsWith(href + "/")) && href.length > bestLength) {
              best = link;
              bestLength = href.length;
            }
          });
          nav.querySelectorAll("a.is-active").forEach((link) => link.classList.remove("is-active"));
          best?.classList.add("is-active");
        });

        // El sidebar tiene 150 enlaces: hay que llevar la vista al actual.
        const sidebar = document.querySelector<HTMLElement>(".docs-sidebar");
        const active = sidebar?.querySelector<HTMLElement>("a.is-active");
        if (sidebar && active) sidebar.scrollTop = active.offsetTop - sidebar.clientHeight / 2;
      }

      /* ── Índice de la página ───────────────────────────────── */
      const slugify = (text: string) =>
        text
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "");

      let tocObserver: IntersectionObserver | null = null;

      function buildToc() {
        const toc = document.querySelector<HTMLElement>("[data-toc]");
        const content = document.querySelector<HTMLElement>("[data-content]");
        if (!toc || !content) return;

        tocObserver?.disconnect();
        toc.innerHTML = "";
        document.querySelector(".docs-toc")?.toggleAttribute("hidden", false);

        const headings = Array.from(content.querySelectorAll<HTMLHeadingElement>("h2"));
        if (headings.length < 2) {
          document.querySelector(".docs-toc")?.setAttribute("hidden", "");
          return;
        }

        const links = new Map<string, HTMLAnchorElement>();
        headings.forEach((heading) => {
          if (!heading.id) heading.id = slugify(heading.textContent ?? "");
          if (!heading.id) return;
          const link = document.createElement("a");
          link.href = `#${heading.id}`;
          link.textContent = heading.textContent ?? "";
          link.dataset.tocLink = heading.id;
          toc.appendChild(link);
          links.set(heading.id, link);
        });

        tocObserver = new IntersectionObserver(
          (entries) => {
            const current = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
            if (!current) return;
            links.forEach((link, id) => link.classList.toggle("is-active", id === current.target.id));
          },
          { rootMargin: "-90px 0px -70% 0px", threshold: 0 },
        );
        headings.forEach((heading) => tocObserver?.observe(heading));
      }

      /* ── Botones de copiar en los bloques de código ────────── */
      function addCopyButtons() {
        document.querySelectorAll<HTMLElement>(".code-block-wrapper").forEach((block) => {
          if (block.querySelector("[data-copy]")) return;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy-btn";
          button.dataset.copy = "";
          button.textContent = "Copiar";
          if (!block.querySelector(".code-header")) {
            button.classList.add("is-floating");
          }
          (block.querySelector(".code-header") ?? block).appendChild(button);
        });
      }

      /* ── Ejecutar bloques Forja + mini consola ─────────────── */
      function esForja(codigo: string) {
        // Sin comentarios ni strings, para no confundir palabras sueltas.
        const limpio = codigo
          .replace(/\/\/[^\n]*/g, " ")
          .replace(/\/\*[\s\S]*?\*\//g, " ")
          .replace(/"(?:[^"\\]|\\.)*"/g, ' "" ')
          .replace(/'(?:[^'\\]|\\.)'/g, " ' ' ");
        // Rust (inglés) → no es Forja, no ejecutable.
        if (/\b(pub|struct|enum|impl|trait|use|mod|match|self|fn|let|unsafe|async|await|dyn|ref|move|where|type|for|while|if|else|return|static|Option|Result|Vec|String)\b/.test(limpio)) {
          return false;
        }
        // Forja (español).
        return /\b(variable|constante|funcion|escribir|leer|para|mientras|si|sino|retornar|clase|rasgo|coincidir|caso|importar|Texto|Entero|Decimal|Booleano|Exacto|verdadero|falso|nulo|requiere|asegura|siempre|nuevo|constructor|implementa|seleccionar|resultado|repetir|romper|continuar|hilo|canal|prestado|enviar|recibir)\b/.test(limpio);
      }

      async function ejecutarBloque(pre: HTMLElement, cons: HTMLElement) {
        const codigo = (pre.textContent ?? "").trim();
        cons.hidden = false;
        cons.classList.add("is-running");
        cons.innerHTML = '<span class="run-msg">Ejecutando…</span>';
        try {
          const { salida, ms } = await ejecutarForja(codigo);
          cons.classList.remove("is-running");
          cons.innerHTML = "";
          if (salida) {
            salida.split("\n").forEach((linea) => {
              const d = document.createElement("div");
              d.className = "run-out";
              d.textContent = linea || " ";
              cons.appendChild(d);
            });
          } else {
            cons.innerHTML = '<span class="run-msg">(sin salida)</span>';
          }
          const tiempo = document.createElement("div");
          tiempo.className = "run-time";
          tiempo.textContent = ms + " ms";
          cons.appendChild(tiempo);
        } catch (err) {
          cons.classList.remove("is-running");
          cons.innerHTML = `<span class="run-error">${(err as Error).message}</span>`;
        }
      }

      function initRunBlocks() {
        document.querySelectorAll<HTMLElement>("pre").forEach((pre) => {
          // Forja = palabras clave en español; los bloques de Rust/bash/salida no.
          const codigo = (pre.textContent ?? "").trim();
          if (!esForja(codigo)) return;
          const contenedor = pre.closest<HTMLElement>(".code-block-wrapper") ?? pre;
          if (contenedor.querySelector("[data-run-btn]")) return;

          const boton = document.createElement("button");
          boton.type = "button";
          boton.className = "run-btn";
          boton.dataset.runBtn = "";
          boton.innerHTML = '<svg class="ico" aria-hidden="true"><use href="#i-play"/></svg> Ejecutar';

          const consola = document.createElement("div");
          consola.className = "run-console";
          consola.hidden = true;
          consola.innerHTML = '<span class="run-msg">Presioná Ejecutar para correr este ejemplo</span>';

          const header = contenedor.querySelector(".code-header");
          if (header) {
            header.appendChild(boton);
            pre.after(consola);
          } else {
            pre.after(boton, consola);
          }
          boton.addEventListener("click", () => ejecutarBloque(pre, consola));
        });
      }

      /* ── Ver código desde GitHub (arquitectura) ────────────── */
      function initVerCodigo() {
        const seccion = document.querySelector<HTMLElement>("[data-ver-codigo]");
        if (!seccion) return;
        const boton = seccion.querySelector<HTMLButtonElement>("[data-ver-codigo-btn]");
        const cuerpo = seccion.querySelector<HTMLElement>("[data-ver-codigo-cuerpo]");
        if (!boton || !cuerpo || boton.dataset.listo) return;
        boton.dataset.listo = "1";

        boton.addEventListener("click", async () => {
          if (seccion.classList.contains("is-open")) {
            seccion.classList.remove("is-open");
            cuerpo.hidden = true;
            return;
          }
          const repo = seccion.dataset.repo ?? "";
          const ruta = seccion.dataset.ruta ?? "";
          seccion.classList.add("is-open");
          cuerpo.hidden = false;
          cuerpo.innerHTML =
            '<span class="ver-codigo-cargando"><svg class="ico spinner" aria-hidden="true"><use href="#i-loader-circle"/></svg> Cargando…</span>';
          try {
            const res = await fetch(`https://raw.githubusercontent.com/${repo}/main/${ruta}`);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const texto = await res.text();
            const pre = document.createElement("pre");
            pre.className = "ver-codigo-pre";
            const code = document.createElement("code");
            code.innerHTML = ruta.endsWith(".rs") ? resaltarRust(texto) : resaltarForja(texto);
            pre.appendChild(code);
            cuerpo.innerHTML = "";
            cuerpo.appendChild(pre);
          } catch (err) {
            cuerpo.innerHTML = `<span class="ver-codigo-error">No se pudo cargar ${ruta}: ${(err as Error).message}</span>`;
          }
        });
      }

      /* ── Paginador anterior / siguiente ────────────────────── */
      function buildPager(navLinks: { title: string; href: string }[]) {
        const content = document.querySelector<HTMLElement>("[data-content]");
        if (!content || navLinks.length === 0) return;
        content.querySelector(".pager")?.remove();
        const current = normalize(location.pathname);
        const index = navLinks.findIndex((link) => normalize(link.href) === current);
        if (index < 0) return;

        const pager = document.createElement("nav");
        pager.className = "pager";
        pager.setAttribute("aria-label", "Páginas anterior y siguiente");

        const previous = navLinks[index - 1];
        const next = navLinks[index + 1];
        if (previous) {
          pager.insertAdjacentHTML(
            "beforeend",
            `<a href="${previous.href}"><span>← Anterior</span><strong>${previous.title}</strong></a>`,
          );
        }
        if (next) {
          pager.insertAdjacentHTML(
            "beforeend",
            `<a class="next" href="${next.href}"><span>Siguiente →</span><strong>${next.title}</strong></a>`,
          );
        }
        if (pager.childElementCount > 0) content.appendChild(pager);
      }

      /* ── Barra de progreso de lectura ──────────────────────── */
      let progressFrame = 0;

      function updateProgress() {
        progressFrame = 0;
        const bar = document.querySelector<HTMLElement>("#progress");
        if (!bar) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = `${max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0}%`;
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!progressFrame) progressFrame = requestAnimationFrame(updateProgress);
        },
        { passive: true },
      );

      /* ── Diagramas mermaid (carga perezosa) ──────────────── */
      let mermaidApi: any = null;

      async function renderMermaid() {
        const nodos = document.querySelectorAll(".mermaid:not([data-processed])");
        if (!nodos.length) return;
        try {
          if (!mermaidApi) {
            const mod = await import("mermaid");
            mermaidApi = mod.default ?? mod;
            mermaidApi.initialize({ startOnLoad: false, theme: "dark", securityLevel: "loose" });
          }
          await mermaidApi.run({ nodes: nodos });
        } catch (err) {
          console.warn("Mermaid no disponible:", (err as Error)?.message ?? err);
        }
      }

      /* ── Arranque y reinicio en cada navegación ────────────── */
      function initPage() {
        document.querySelector("#mobile-menu")?.classList.remove("is-open");
        document.documentElement.style.overflow = "";
        // El ClientRouter reemplaza el <html> (con data-theme="dark" hardcodeado)
        // en cada navegación: re-aplicar el tema guardado para no volver a oscuro.
        const guardado = localStorage.getItem(THEME_KEY);
        if (guardado === "light" || guardado === "dark") aplicarTema(guardado);
        markActive();
        buildToc();
        addCopyButtons();
        initRunBlocks();
        initVerCodigo();
        buildPager(navLinks);
        renderMermaid();
        updateProgress();
        // Compatibilidad: playground y DemoForja esperan este evento.
        window.dispatchEvent(new CustomEvent("page-loaded", { detail: location.pathname }));
      }

      document.addEventListener("astro:page-load", initPage);
      initPage();
    </script>
  </body>
</html>
