---
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Documentación del lenguaje de programación Forja (fa)" } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title.includes("Forja") ? title : `${title} | Forja`}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/docs/favicon.ico" />
    <meta name="theme-color" content="#0a0908" data-theme-color />
    <ClientRouter />

    <script is:inline>
      // El tema se aplica antes del primer paint para no parpadear.
      (() => {
        const query = new URLSearchParams(location.search).get("theme");
        const stored = localStorage.getItem("forja-theme");
        const theme = query === "light" || query === "dark" ? query : stored === "light" || stored === "dark" ? stored : "dark";
        if (query === "light" || query === "dark") localStorage.setItem("forja-theme", theme);
        document.documentElement.dataset.theme = theme;
        document
          .querySelector("[data-theme-color]")
          ?.setAttribute("content", theme === "light" ? "#f7f4ee" : "#0a0908");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Saltar al contenido</a>
    <div id="progress" aria-hidden="true"></div>

    <Header />

    <div class="docs-shell container-wide">
      <aside class="docs-sidebar" aria-label="Documentación">
        <Sidebar />
      </aside>

      <main class="docs-content prose" id="content" data-content>
        <slot />
      </main>

      <aside class="docs-toc" aria-label="En esta página">
        <div class="docs-label">En esta página</div>
        <nav class="toc-nav" data-toc></nav>
      </aside>
    </div>

    <Footer />

    <script>
      import { navLinks } from "../data/nav";

      /* ── Tema ──────────────────────────────────────────────── */
      const THEME_KEY = "forja-theme";

      function setTheme(theme: "dark" | "light") {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem(THEME_KEY, theme);
        document
          .querySelector("[data-theme-color]")
          ?.setAttribute("content", theme === "light" ? "#f7f4ee" : "#0a0908");
      }

      /* ── Listener delegados: el router reemplaza el <body> ── */
      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        if (target.closest("[data-theme-toggle]")) {
          setTheme(document.documentElement.dataset.theme === "light" ? "dark" : "light");
          return;
        }

        if (target.closest("[data-menu-toggle]")) {
          const menu = document.querySelector<HTMLElement>("#mobile-menu");
          const open = menu?.classList.toggle("is-open") ?? false;
          document.documentElement.style.overflow = open ? "hidden" : "";
          document.querySelector("[data-menu-toggle]")?.setAttribute("aria-expanded", String(open));
          return;
        }

        const copy = target.closest<HTMLButtonElement>("[data-copy]");
        if (copy) {
          const code = copy.closest(".code-block-wrapper")?.querySelector("pre")?.textContent ?? "";
          navigator.clipboard.writeText(code);
          copy.textContent = "Copiado";
          copy.classList.add("is-copied");
          setTimeout(() => {
            copy.textContent = "Copiar";
            copy.classList.remove("is-copied");
          }, 1600);
        }
      });

      document.addEventListener("input", (event) => {
        const input = event.target as HTMLInputElement | null;
        if (!input?.matches("[data-nav-search]")) return;
        const query = input.value.trim().toLowerCase();
        document.querySelectorAll<HTMLElement>("[data-nav] .docs-group").forEach((group) => {
          let visible = 0;
          group.querySelectorAll("a").forEach((link) => {
            const match = (link.textContent ?? "").toLowerCase().includes(query);
            link.hidden = !match;
            if (match) visible++;
          });
          group.hidden = query.length > 0 && visible === 0;
        });
      });

      /* ── Estado activo del sidebar ─────────────────────────── */
      const normalize = (path: string) => path.replace(/\/+$/, "") || "/docs";

      function markActive() {
        const current = normalize(location.pathname);
        document.querySelectorAll<HTMLElement>("[data-nav]").forEach((nav) => {
          let best: HTMLAnchorElement | null = null;
          let bestLength = -1;
          nav.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
            const href = normalize(link.getAttribute("href") ?? "");
            if (!href.startsWith("/docs")) return;
            if ((current === href || current.startsWith(href + "/")) && href.length > bestLength) {
              best = link;
              bestLength = href.length;
            }
          });
          nav.querySelectorAll("a.is-active").forEach((link) => link.classList.remove("is-active"));
          best?.classList.add("is-active");
        });

        // El sidebar tiene 150 enlaces: hay que llevar la vista al actual.
        const sidebar = document.querySelector<HTMLElement>(".docs-sidebar");
        const active = sidebar?.querySelector<HTMLElement>("a.is-active");
        if (sidebar && active) sidebar.scrollTop = active.offsetTop - sidebar.clientHeight / 2;
      }

      /* ── Índice de la página ───────────────────────────────── */
      const slugify = (text: string) =>
        text
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "");

      let tocObserver: IntersectionObserver | null = null;

      function buildToc() {
        const toc = document.querySelector<HTMLElement>("[data-toc]");
        const content = document.querySelector<HTMLElement>("[data-content]");
        if (!toc || !content) return;

        tocObserver?.disconnect();
        toc.innerHTML = "";
        document.querySelector(".docs-toc")?.toggleAttribute("hidden", false);

        const headings = Array.from(content.querySelectorAll<HTMLHeadingElement>("h2"));
        if (headings.length < 2) {
          document.querySelector(".docs-toc")?.setAttribute("hidden", "");
          return;
        }

        const links = new Map<string, HTMLAnchorElement>();
        headings.forEach((heading) => {
          if (!heading.id) heading.id = slugify(heading.textContent ?? "");
          if (!heading.id) return;
          const link = document.createElement("a");
          link.href = `#${heading.id}`;
          link.textContent = heading.textContent ?? "";
          link.dataset.tocLink = heading.id;
          toc.appendChild(link);
          links.set(heading.id, link);
        });

        tocObserver = new IntersectionObserver(
          (entries) => {
            const current = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
            if (!current) return;
            links.forEach((link, id) => link.classList.toggle("is-active", id === current.target.id));
          },
          { rootMargin: "-90px 0px -70% 0px", threshold: 0 },
        );
        headings.forEach((heading) => tocObserver?.observe(heading));
      }

      /* ── Botones de copiar en los bloques de código ────────── */
      function addCopyButtons() {
        document.querySelectorAll<HTMLElement>(".code-block-wrapper").forEach((block) => {
          if (block.querySelector("[data-copy]")) return;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy-btn";
          button.dataset.copy = "";
          button.textContent = "Copiar";
          if (!block.querySelector(".code-header")) {
            button.classList.add("is-floating");
          }
          (block.querySelector(".code-header") ?? block).appendChild(button);
        });
      }

      /* ── Paginador anterior / siguiente ────────────────────── */
      function buildPager(navLinks: { title: string; href: string }[]) {
        const content = document.querySelector<HTMLElement>("[data-content]");
        if (!content || navLinks.length === 0) return;
        content.querySelector(".pager")?.remove();
        const current = normalize(location.pathname);
        const index = navLinks.findIndex((link) => normalize(link.href) === current);
        if (index < 0) return;

        const pager = document.createElement("nav");
        pager.className = "pager";
        pager.setAttribute("aria-label", "Páginas anterior y siguiente");

        const previous = navLinks[index - 1];
        const next = navLinks[index + 1];
        if (previous) {
          pager.insertAdjacentHTML(
            "beforeend",
            `<a href="${previous.href}"><span>← Anterior</span><strong>${previous.title}</strong></a>`,
          );
        }
        if (next) {
          pager.insertAdjacentHTML(
            "beforeend",
            `<a class="next" href="${next.href}"><span>Siguiente →</span><strong>${next.title}</strong></a>`,
          );
        }
        if (pager.childElementCount > 0) content.appendChild(pager);
      }

      /* ── Barra de progreso de lectura ──────────────────────── */
      let progressFrame = 0;

      function updateProgress() {
        progressFrame = 0;
        const bar = document.querySelector<HTMLElement>("#progress");
        if (!bar) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = `${max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0}%`;
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!progressFrame) progressFrame = requestAnimationFrame(updateProgress);
        },
        { passive: true },
      );

      /* ── Arranque y reinicio en cada navegación ────────────── */
      function initPage() {
        document.querySelector("#mobile-menu")?.classList.remove("is-open");
        document.documentElement.style.overflow = "";
        markActive();
        buildToc();
        addCopyButtons();
        buildPager(navLinks);
        updateProgress();
        // Compatibilidad: playground y DemoForja esperan este evento.
        window.dispatchEvent(new CustomEvent("page-loaded", { detail: location.pathname }));
      }

      document.addEventListener("astro:page-load", initPage);
      initPage();
    </script>
  </body>
</html>
