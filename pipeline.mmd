---
title: Pipeline de Compilación — Forja (fa)
---

%% ═══════════════════════════════════════════════════════════════
%%   DIAGRAMA 1: FLUJO PRINCIPAL
%% ═══════════════════════════════════════════════════════════════

flowchart TD
    subgraph Source["📄 Código Fuente"]
        S(["`**source.fa** 🗒️
            texto plano`"])
    end

    subgraph F1["FASE 1 · Lexer"]
        L(["`**Lexer**
            📖 lexer.rs
            texto → tokens`"])
    end

    subgraph F2["FASES 2-3 · Parser"]
        P(["`**Parser**
            🔧 parser.rs
            tokens → AST
            _recursive descent_`"])
    end

    subgraph F3["FASE 4 · Semántica"]
        TC(["`**Type Checker**
            🔍 semantics.rs
            inferencia de tipos`"])
        BC(["`**Borrow Checker**
            🔍 semantics.rs
            ownership · mutabilidad`"])
    end

    subgraph F4["FASE 4c · Optimización"]
        OPT(["`**Optimizer**
            📐 optimizer.rs
            constant folding
            dead code elimination`"])
    end

    subgraph F5["FASE 5 · Generación de Código"]
        TR(["`**Transpilador**
            🦀 transpiler.rs
            Forja → Rust (.rs)`"])
        BCG(["`**Bytecode Gen**
            💾 bytecode.rs
            AST → Opcodes`"])
        UOP(["`**Uops**
            🔬 uops.rs
            micro-opcodes`"])
        ASM(["`**Compilador ASM**
            ⚡ compiler_asm.rs
            Forja → Assembly
            x86-64 / ARM64`"])
        LLVM(["`**Compilador LLVM**
            ⚡ compiler_llvm.rs
            Forja → LLVM IR`"])
    end

    subgraph F6["FASE 6 · Ejecución"]
        VM1(["`**VM v1**
            ⚙️ vm.rs
            stack-based`"])
        VMJIT(["`**VM v3 DT**
            ⚡ vm_jit.rs
            direct threading`"])
        VM5(["`**VM v5 Fast** 🏆
            🚀 vm_fast.rs
            NaN tagging · stack caching`"])
        JIT(["`**NativeJIT**
            🔥 jit.rs + jit_engine.rs
            código máquina x86-64`"])
        GCC(["`**gcc -O2**
            ensamblador → .exe`"])
    end

    subgraph F7["FASE 7 · Distribución"]
        AOT(["`**AOT + Selfrun**
            📦 aot.rs + selfrun.rs
            .exe autónomo`"])
        WASM(["`**WASM**
            🌐 forja-wasm
            playground web`"])
    end

    S --> L
    L --> P
    P --> TC
    TC --> BC
    BC --> OPT

    OPT --> TR
    OPT --> BCG
    OPT --> ASM
    OPT --> LLVM

    BCG --> UOP

    UOP --> VM1
    UOP --> VMJIT
    UOP --> VM5
    VM5 --> JIT

    ASM --> GCC
    GCC --> AOT

    JIT --> AOT
    AOT --> WASM

    TR -.-> FIN_RUST(["`📄 código Rust (.rs)`"])
    UOP -.-> FIN_FBC(["`💾 bytecode (.fbc)`"])
    ASM -.-> FIN_ASM(["`📄 assembly (.s)`"])
    GCC -.-> FIN_EXE(["`⚡ ejecutable (.exe)`"])
    WASM -.-> FIN_WASM(["`🌐 WebAssembly / Playground`"])

    classDef source fill:#2d2d3d,stroke:#7c7c9e,color:#fff
    classDef lexer fill:#1a3a5c,stroke:#4a8ccf,color:#e0e0e0
    classDef parser fill:#2d5a1e,stroke:#5cb84a,color:#e0e0e0
    classDef semantic fill:#5a2d1e,stroke:#c8783a,color:#e0e0e0
    classDef opt fill:#3a2d5a,stroke:#8a5ac8,color:#e0e0e0
    classDef generator fill:#1e3a3a,stroke:#3aa0a0,color:#e0e0e0
    classDef ejec fill:#3a1e3a,stroke:#c060c0,color:#e0e0e0
    classDef dist fill:#2a2a1e,stroke:#a0a040,color:#e0e0e0
    classDef out fill:#333,stroke:#666,color:#999,stroke-dasharray:4 4

    class S source
    class L lexer
    class P parser
    class TC,BC semantic
    class OPT opt
    class TR,BCG,UOP,ASM,LLVM generator
    class VM1,VMJIT,VM5,JIT,GCC ejec
    class AOT,WASM dist
    class FIN_RUST,FIN_FBC,FIN_ASM,FIN_EXE,FIN_WASM out

%% ═══════════════════════════════════════════════════════════════
%%   DIAGRAMA 2: RUTAS POR COMANDO
%% ═══════════════════════════════════════════════════════════════

flowchart LR
    subgraph RUTAS["RUTAS POR COMANDO CLI"]
        C1["`**forja run**`"] --> R1["Lexer → Parser → TC → BC → Opt → Bytecode → Uops → **ForjaFast v5**"]
        C2["`**forja build**`"] --> R2["Lexer → Parser → TC → BC → Opt → Bytecode → **AOT + Selfrun** → .exe"]
        C3["`**forja build-asm**`"] --> R3["Lexer → Parser → **Compiler ASM** → .s → gcc -O2 → .exe"]
        C4["`**forja .fa**`"] --> R4["Lexer → Parser → TC → BC → Opt → **Transpilador** → código Rust (.rs)"]
        C5["`**forja repl**`"] --> R5["Lexer → Parser → Bytecode → **ForjaFast** (variables persisten)"]
        C6["`**forja fmt**`"] --> R6["Lexer → Parser → **Formatter** → código formateado"]
        C7["`**forja diagrama**`"] --> R7["Lexer → Parser → **DiagramGenerator** → HTML interactivo"]
        C8["`**forja build-wasm**`"] --> R8["Lexer → Parser → TC → BC → Opt → Bytecode → **WASM binding**"]
    end

    classDef cmd fill:#1a1a2e,stroke:#4a4a8f,color:#fff
    classDef ruta fill:#1e3a2e,stroke:#3aa060,color:#e0e0e0

    class C1,C2,C3,C4,C5,C6,C7,C8 cmd
    class R1,R2,R3,R4,R5,R6,R7,R8 ruta

