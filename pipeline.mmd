flowchart TB
    subgraph TABLA["TABLA DE FASES DEL PIPELINE"]
        F1T["1 · Lexer
             lexer.rs
             texto → Vec<Token>"]
        F2T["2-3 · Parser
              parser.rs · 34 reglas
              Vec<Token> → Programa (AST)"]
        F4AT["4a · Type Checker
              semantics.rs
              inferencia de tipos"]
        F4BT["4b · Borrow Checker
              semantics.rs
              ownership · scoping"]
